+def _build_uid_map(root: ET.Element) -> dict[str, ET.Element]:
+    """Map UniqueId → Item for identity matching when Referent is absent."""
+    uid_map: dict[str, ET.Element] = {}
+    for item in root.iter("Item"):
+        if item.tag != "Item":
+            continue
+        uid = _get_unique_id(item)
+        if uid and uid not in uid_map:
+            uid_map[uid] = item
+    return uid_map
+
+
+def _is_real_named_uniquify_path(c: dict[str, Any]) -> bool:
+    """True when path Foo_2 is a real instance named Foo_2, not a collision suffix.
+
+    Collision leftovers have meta Name equal to the bare stem (Foo) or no Name.
+    A real sibling whose Name property is Foo_2 must be imported, even when a
+    Foo sibling exists and Referent is missing (local.json is gitignored).
+    """
+    path_key = c.get("path_key") or ""
+    is_uni, _bare = _is_uniquified_path(path_key)
+    if not is_uni:
+        return False
+    stem = path_key.split("/")[-1]
+    meta = c.get("meta") or {}
+    meta_name = meta.get("Name")
+    if meta_name is None:
+        return False
+    return str(meta_name) == stem
+
+
